diff --git a/lib/elementor-a11y-html.ts b/lib/elementor-a11y-html.ts
new file mode 100644
index 0000000..4866ec6
--- /dev/null
+++ b/lib/elementor-a11y-html.ts
@@ -0,0 +1,102 @@
+/** Conservative Elementor HTML a11y pass: missing img alt + nameless links. */
+
+const IMG_TAG_RE = /<img\b[^>]*>/gi;
+const ANCHOR_RE = /<a\b([^>]*)>([\s\S]*?)<\/a>/gi;
+const DECORATIVE_SRC = /pixel\.gif|spacer|1x1|rectangle\d*\.svg|shape[-_]|divider|ornament|confeti|confetti|background\.webp/i;
+
+function getQuotedAttr(tag: string, name: string): string | null {
+  const match = tag.match(new RegExp(`\\s${name}=("[^"]*"|'[^']*')`, 'i'));
+  if (!match) return null;
+  return match[1].slice(1, -1);
+}
+
+function escapeAttr(value: string): string {
+  return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
+}
+
+function basenameFromSrc(src: string): string {
+  try {
+    const path = new URL(src, 'https://playfulagency.com').pathname;
+    return path.slice(path.lastIndexOf('/') + 1);
+  } catch {
+    const clean = src.split('?')[0].split('#')[0];
+    return clean.slice(clean.lastIndexOf('/') + 1);
+  }
+}
+
+export function descriptiveAltFromSrc(src: string): string {
+  if (!src || src.startsWith('data:') || DECORATIVE_SRC.test(src)) return '';
+  const base = basenameFromSrc(src)
+    .replace(/-\d+x\d+(?=\.[^.]+$)/, '')
+    .replace(/\.[^.]+$/, '')
+    .replace(/[_-]+/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+  return base;
+}
+
+export function ensureMissingImgAlt(html: string): string {
+  if (!html) return html;
+  IMG_TAG_RE.lastIndex = 0;
+  return html.replace(IMG_TAG_RE, (tag) => {
+    if (/\salt\s*=/i.test(tag)) return tag;
+    const src = getQuotedAttr(tag, 'src') || '';
+    const alt = descriptiveAltFromSrc(src);
+    if (/\/>$/.test(tag)) {
+      return tag.replace(/\s*\/>$/, ` alt="${escapeAttr(alt)}" />`);
+    }
+    return tag.replace(/>$/, ` alt="${escapeAttr(alt)}">`);
+  });
+}
+
+function innerText(html: string): string {
+  return html
+    .replace(/<script[\s\S]*?<\/script>/gi, '')
+    .replace(/<style[\s\S]*?<\/style>/gi, '')
+    .replace(/<[^>]+>/g, ' ')
+    .replace(/&nbsp;/gi, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+function labelFromHref(href: string): string {
+  if (!href || href === '#' || href.startsWith('javascript:')) return 'Enlace';
+  try {
+    const url = new URL(href, 'https://playfulagency.com');
+    const last = url.pathname.split('/').filter(Boolean).pop();
+    if (last) return last.replace(/[-_]+/g, ' ');
+    if (url.hostname && url.hostname !== 'playfulagency.com') return url.hostname.replace(/^www\./, '');
+  } catch {
+    /* keep fallback */
+  }
+  return 'Enlace';
+}
+
+export function labelEmptyLinks(html: string): string {
+  if (!html) return html;
+  ANCHOR_RE.lastIndex = 0;
+  return html.replace(ANCHOR_RE, (full, attrs: string, inner: string) => {
+    if (/\saria-label\s*=/i.test(attrs)) return full;
+    if (innerText(inner)) return full;
+    const title = getQuotedAttr(`<a${attrs}>`, 'title');
+    const imgAlt = /alt=("[^"]*"|'[^']*')/i.exec(inner)?.[1]?.slice(1, -1);
+    const href = getQuotedAttr(`<a${attrs}>`, 'href') || '';
+    const label = (title && title.trim())
+      || (imgAlt && imgAlt.trim())
+      || labelFromHref(href);
+    return `<a${attrs} aria-label="${escapeAttr(label)}">${inner}</a>`;
+  });
+}
+
+export function stripInvalidButtonAriaSelected(html: string): string {
+  if (!html) return html;
+  return html.replace(/<div\b([^>]*)>/gi, (full, attrs: string) => {
+    if (!/\brole=["']button["']/i.test(attrs)) return full;
+    if (!/\saria-selected=/i.test(attrs)) return full;
+    return `<div${attrs.replace(/\saria-selected=("[^"]*"|'[^']*')/i, '')}>`;
+  });
+}
+
+export function applyElementorA11y(html: string): string {
+  return stripInvalidButtonAriaSelected(labelEmptyLinks(ensureMissingImgAlt(html)));
+}
diff --git a/tests/elementor-a11y-html.test.mjs b/tests/elementor-a11y-html.test.mjs
new file mode 100644
index 0000000..7fa0c99
--- /dev/null
+++ b/tests/elementor-a11y-html.test.mjs
@@ -0,0 +1,78 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  applyElementorA11y,
+  descriptiveAltFromSrc,
+  ensureMissingImgAlt,
+  labelEmptyLinks,
+} from '../lib/elementor-a11y-html.ts';
+
+const elementor = readFileSync(
+  new URL('../components/ElementorPageContent.tsx', import.meta.url),
+  'utf8',
+);
+
+test('Elementor page content runs the a11y pass after alt overrides', () => {
+  assert.match(elementor, /applyElementorA11y\(/);
+  assert.match(elementor, /applyImageAltOverrides\(/);
+  const a11yAt = elementor.indexOf('applyElementorA11y(');
+  const altAt = elementor.indexOf('applyImageAltOverrides(');
+  assert.ok(a11yAt !== -1 && altAt !== -1 && a11yAt < altAt);
+});
+
+test('descriptiveAltFromSrc turns filenames into readable alt and blanks decorative srcs', () => {
+  assert.equal(
+    descriptiveAltFromSrc('https://endpoint.playfulagency.com/wp-content/uploads/2024/09/Haz-Pruebas-y-Optimiza-tus-Campanas.png'),
+    'Haz Pruebas y Optimiza tus Campanas',
+  );
+  assert.equal(
+    descriptiveAltFromSrc('https://endpoint.playfulagency.com/wp-content/plugins/wti-like-post/images/pixel.gif'),
+    '',
+  );
+  assert.equal(descriptiveAltFromSrc('data:image/gif;base64,xx'), '');
+});
+
+test('ensureMissingImgAlt adds alt only when the attribute is absent', () => {
+  const missing = '<p>x</p><img src="/images/foo-bar.png" width="10"><p>y</p>';
+  assert.equal(
+    ensureMissingImgAlt(missing),
+    '<p>x</p><img src="/images/foo-bar.png" width="10" alt="foo bar"><p>y</p>',
+  );
+  const present = '<img src="/images/foo-bar.png" alt="Ya existe">';
+  assert.equal(ensureMissingImgAlt(present), present);
+  const empty = '<img src="/images/foo-bar.png" alt="">';
+  assert.equal(ensureMissingImgAlt(empty), empty);
+});
+
+test('labelEmptyLinks names icon-only anchors and leaves text links alone', () => {
+  const icon = '<a href="https://www.instagram.com/somosplayful"><i class="fab fa-instagram"></i></a>';
+  assert.equal(
+    labelEmptyLinks(icon),
+    '<a href="https://www.instagram.com/somosplayful" aria-label="somosplayful"><i class="fab fa-instagram"></i></a>',
+  );
+  const named = '<a href="/agencia-seo">SEO</a>';
+  assert.equal(labelEmptyLinks(named), named);
+  const titled = '<a href="/x" title="Caso SoyTechno"></a>';
+  assert.equal(
+    labelEmptyLinks(titled),
+    '<a href="/x" title="Caso SoyTechno" aria-label="Caso SoyTechno"></a>',
+  );
+});
+
+test('strips aria-selected from Elementor tab titles that are role=button', () => {
+  const html =
+    '<div id="elementor-tab-title-1551" class="elementor-tab-title" role="button" aria-controls="x" aria-expanded="false" aria-selected="false">FAQ</div>';
+  assert.equal(
+    applyElementorA11y(html),
+    '<div id="elementor-tab-title-1551" class="elementor-tab-title" role="button" aria-controls="x" aria-expanded="false">FAQ</div>',
+  );
+});
+
+test('applyElementorA11y is idempotent on mixed markup', () => {
+  const html = '<a href="/blog/seo/auditoria-seo-que-es-como-se-hace"><img src="/images/audit-cover.png"></a>';
+  const once = applyElementorA11y(html);
+  assert.equal(applyElementorA11y(once), once);
+  assert.match(once, /alt="audit cover"/);
+  assert.match(once, /aria-label="audit cover"/);
+});
